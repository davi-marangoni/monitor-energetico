# Configuração da API
API_URL=http://localhost:8000/api

# Credenciais (usar uma das duas opções)
# Opção 1: Username e Password
API_USERNAME=seu_usuario
API_PASSWORD=sua_senha

# Opção 2: Token JWT
API_TOKEN=seu_token_jwt

# Intervalos de coleta e envio (em segundos)
INTERVALO_COLETA=60
INTERVALO_ENVIO=300

# Caminho da fila local SQLite
FILA_DB_PATH=/var/lib/monitor-energetico/fila.db

# Logging
LOG_PATH=/var/log/monitor-energetico
LOG_LEVEL=INFO
